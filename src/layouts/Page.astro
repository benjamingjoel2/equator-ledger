---
import Base from './Base.astro';
import { SITE } from '../data/site';
import { formatDate } from '../lib/posts';
interface Props { title: string; description: string; path: string; kicker?: string; updated?: string; sources?: { title: string; publisher: string; url: string }[] }
const { title, description, path, kicker = 'About this site', updated = SITE.launched, sources = [] } = Astro.props;
const url = new URL(path, SITE.url).href;
const webPage = {
  '@type': 'WebPage',
  '@id': `${url}#page`,
  name: title,
  description,
  url,
  datePublished: SITE.launched,
  dateModified: updated,
  inLanguage: 'en',
  isPartOf: { '@id': `${SITE.url}/#website` },
  publisher: { '@id': `${SITE.url}/#publisher` },
};
---
<Base title={title} description={description} crumbs={[{ name: 'Home', path: '/' }, { name: title, path }]} extraGraph={[webPage]}>
  <article class="wrap">
    <header class="page-head">
      <p class="kicker">{kicker}</p>
      <h1>{title}</h1>
      <p class="meta"><span>Published <time datetime={SITE.launched}>{formatDate(new Date(SITE.launched))}</time></span><span>Last updated <time datetime={updated}>{formatDate(new Date(updated))}</time></span></p>
    </header>
    <div class="prose">
      <slot />
    </div>
    {sources.length > 0 && (
      <section class="sources" aria-labelledby="sources-heading">
        <h2 id="sources-heading">Sources</h2>
        <ol>{sources.map((s) => <li><a href={s.url} rel="noopener">{s.title}</a> <span class="pub">({s.publisher})</span></li>)}</ol>
      </section>
    )}
  </article>
</Base>
